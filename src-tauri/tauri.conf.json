{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetScope",
  "version": "0.1.0",
  "identifier": "dev.netscope.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetScope - 网络监控与诊断",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
